---
// Text Transformer Component
---

<div class="max-w-6xl mx-auto">
    <div class="tool-panel space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-white/5">
            <label for="text-input" class="tool-label !mb-0">Texto de entrada</label>
            <button id="copy-all-btn" class="tool-btn tool-btn-ghost !py-1.5 !px-3 !text-[10px] uppercase tracking-wider">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                Copiar todos
            </button>
        </div>

        <textarea
            id="text-input"
            class="tool-textarea h-40 resize-none"
            placeholder="Escribe o pega texto aquí..."
            spellcheck="false"
        ></textarea>

        <div id="transforms-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            <!-- Outputs rendered by script -->
        </div>
    </div>
</div>

<script>
    interface TransformDef {
        key: string;
        label: string;
        fn: (input: string, tokens: string[]) => string;
    }

    const transforms: TransformDef[] = [
        { key: 'camel',      label: 'camelCase',       fn: (_, tokens) => toCamel(tokens) },
        { key: 'pascal',     label: 'PascalCase',      fn: (_, tokens) => toPascal(tokens) },
        { key: 'snake',      label: 'snake_case',      fn: (_, tokens) => toSeparator(tokens, '_') },
        { key: 'kebab',      label: 'kebab-case',      fn: (_, tokens) => toSeparator(tokens, '-') },
        { key: 'constant',   label: 'CONSTANT_CASE',   fn: (_, tokens) => toConstant(tokens) },
        { key: 'dot',        label: 'dot.case',        fn: (_, tokens) => toSeparator(tokens, '.') },
        { key: 'path',       label: 'path/case',       fn: (_, tokens) => toSeparator(tokens, '/') },
        { key: 'train',      label: 'Train-Case',      fn: (_, tokens) => toTrain(tokens) },
        { key: 'lower',      label: 'lower',           fn: (input) => safe(input).toLowerCase() },
        { key: 'upper',      label: 'UPPER',           fn: (input) => safe(input).toUpperCase() },
        { key: 'title',      label: 'Title Case',      fn: (_, tokens) => toTitle(tokens) },
        { key: 'sentence',   label: 'Sentence case',   fn: (input) => toSentence(safe(input)) },
    ];

    const input = document.getElementById('text-input') as HTMLTextAreaElement;
    const grid  = document.getElementById('transforms-grid') as HTMLDivElement;
    const copyAllBtn = document.getElementById('copy-all-btn') as HTMLButtonElement;

    const outputRefs: Record<string, HTMLInputElement> = {};

    function safe(value: unknown): string {
        if (value === null || value === undefined) return '';
        return String(value);
    }

    function tokenize(value: string): string[] {
        const normalized = safe(value)
            .replace(/[_\-.\/]+/g, ' ')
            .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
            .replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2')
            .trim();
        if (!normalized) return [];
        return normalized.split(/\s+/).map((t) => t.toLowerCase());
    }

    function capitalize(word: string): string {
        if (!word) return '';
        return word[0].toUpperCase() + word.slice(1);
    }

    function toCamel(tokens: string[]): string {
        if (!tokens.length) return '';
        return tokens[0] + tokens.slice(1).map(capitalize).join('');
    }

    function toPascal(tokens: string[]): string {
        return tokens.map(capitalize).join('');
    }

    function toSeparator(tokens: string[], sep: string): string {
        return tokens.join(sep);
    }

    function toConstant(tokens: string[]): string {
        return tokens.map((t) => t.toUpperCase()).join('_');
    }

    function toTrain(tokens: string[]): string {
        return tokens.map(capitalize).join('-');
    }

    function toTitle(tokens: string[]): string {
        return tokens.map(capitalize).join(' ');
    }

    function toSentence(value: string): string {
        const trimmed = value.trim();
        if (!trimmed) return '';
        const lower = trimmed.toLowerCase();
        return lower[0].toUpperCase() + lower.slice(1);
    }

    function buildGrid() {
        grid.innerHTML = transforms.map((t) => `
            <div class="tool-output-panel flex flex-col gap-2">
                <div class="flex items-center justify-between">
                    <span class="text-[10px] text-gray-500 uppercase tracking-widest font-bold">${t.label}</span>
                    <button
                        type="button"
                        class="copy-btn tool-btn tool-btn-ghost !py-1 !px-2 !text-[10px]"
                        data-key="${t.key}"
                        aria-label="Copiar ${t.label}"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        Copiar
                    </button>
                </div>
                <input
                    type="text"
                    id="output-${t.key}"
                    class="tool-input !bg-transparent !border-0 !p-0 !shadow-none !font-mono text-sm"
                    readonly
                    value=""
                    aria-label="Resultado ${t.label}"
                />
            </div>
        `).join('');

        transforms.forEach((t) => {
            outputRefs[t.key] = document.getElementById(`output-${t.key}`) as HTMLInputElement;
        });

        grid.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
            btn.addEventListener('click', () => {
                const key = btn.getAttribute('data-key') || '';
                const value = outputRefs[key]?.value || '';
                if (!value) return;
                navigator.clipboard.writeText(value).then(() => {
                    const orig = btn.innerHTML;
                    btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg> ¡Listo!`;
                    btn.classList.add('!text-emerald-400');
                    setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('!text-emerald-400'); }, 2000);
                });
            });
        });
    }

    function updateAll() {
        const value = safe(input.value);
        const tokens = tokenize(value);
        transforms.forEach((t) => {
            const out = outputRefs[t.key];
            if (!out) return;
            try {
                out.value = value.trim() === '' ? '' : t.fn(value, tokens);
            } catch {
                out.value = '';
            }
        });
    }

    function copyAll() {
        const lines = transforms.map((t) => `${t.label}: ${outputRefs[t.key]?.value || ''}`);
        const block = lines.join('\n');
        if (!block.replace(/\s/g, '')) return;
        navigator.clipboard.writeText(block).then(() => {
            const orig = copyAllBtn.innerHTML;
            copyAllBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg> ¡Copiados!`;
            copyAllBtn.classList.add('!text-emerald-400');
            setTimeout(() => { copyAllBtn.innerHTML = orig; copyAllBtn.classList.remove('!text-emerald-400'); }, 2000);
        });
    }

    input.addEventListener('input', updateAll);
    copyAllBtn.addEventListener('click', copyAll);

    buildGrid();
    updateAll();
</script>
