---
// Text Sanitizer Component
---

<div class="max-w-5xl mx-auto">
    <div class="tool-panel space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-white/5">
            <label for="sanitizer-input" class="tool-label !mb-0">Texto de entrada</label>
            <button
                id="sanitizer-clear-btn"
                type="button"
                class="tool-btn tool-btn-ghost !py-1.5 !px-3 !text-[10px] uppercase tracking-wider"
            >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                Limpiar
            </button>
        </div>

        <textarea
            id="sanitizer-input"
            class="tool-textarea h-40 resize-none"
            placeholder="Escribe o pega texto con caracteres invisibles, controles o secuencias especiales..."
            spellcheck="false"
        ></textarea>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-3">
                <span class="tool-label !mb-0">Limpiadores</span>
                <div id="sanitizer-cleaners" class="space-y-2">
                    <!-- Cleaner checkboxes rendered by script -->
                </div>
            </div>

            <div class="space-y-3">
                <label for="sanitizer-escape" class="tool-label !mb-0">Modo de escape</label>
                <select id="sanitizer-escape" class="tool-select">
                    <option value="none">Ninguno</option>
                    <option value="quotes">Comillas y barras</option>
                    <option value="json">Cadena JSON</option>
                    <option value="html">Entidades HTML</option>
                    <option value="url">URL (encodeURIComponent)</option>
                </select>
            </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4">
            <div id="sanitizer-feedback" class="text-sm min-h-[1.25rem]" role="status" aria-live="polite"></div>
            <div class="flex justify-end gap-3">
                <button
                    id="sanitizer-copy-btn"
                    type="button"
                    class="tool-btn tool-btn-primary"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    Copiar resultado
                </button>
            </div>
        </div>

        <div>
            <label for="sanitizer-output" class="tool-label">Texto sanitizado</label>
            <textarea
                id="sanitizer-output"
                class="tool-textarea h-40 resize-none"
                readonly
                aria-label="Texto sanitizado"
            ></textarea>
        </div>

        <div id="sanitizer-log-panel" class="tool-output-panel hidden">
            <p class="text-[10px] text-gray-500 uppercase tracking-widest font-bold mb-3">Registro de detección</p>
            <ul id="sanitizer-log" class="space-y-2"></ul>
        </div>
    </div>
</div>

<script>
    type CleanerKey =
        | 'controlChars'
        | 'nullBytes'
        | 'zeroWidth'
        | 'normalizeLines'
        | 'trim'
        | 'collapseWhitespace';

    type EscapeMode = 'none' | 'quotes' | 'json' | 'html' | 'url';

    interface State {
        input: string;
        cleaners: Record<CleanerKey, boolean>;
        escape: EscapeMode;
    }

    interface StepResult {
        text: string;
        count: number;
        example: string;
    }

    interface LogEntry {
        key: CleanerKey | EscapeMode;
        label: string;
        count: number;
        example: string;
        type: 'removed' | 'escaped';
    }

    interface Result {
        output: string;
        log: LogEntry[];
    }

    interface CleanerDef {
        key: CleanerKey;
        label: string;
        fn: (text: string) => StepResult;
    }

    const CONTROL_REGEX = /[\x01-\x08\x0B\x0C\x0E-\x1F]/g;
    const NULL_REGEX = /\x00/g;
    const ZERO_WIDTH_REGEX = /[\u200B-\u200D\uFEFF\u202A-\u202E\u2060-\u206F\uFE0E\uFE0F]/g;

    const cleaners: CleanerDef[] = [
        {
            key: 'controlChars',
            label: 'Remover caracteres de control ASCII',
            fn: (text) => {
                const next = text.replace(CONTROL_REGEX, '');
                const match = text.match(CONTROL_REGEX);
                const example = match ? `\\x${match[0].charCodeAt(0).toString(16).padStart(2, '0')}` : '';
                return { text: next, count: text.length - next.length, example };
            },
        },
        {
            key: 'nullBytes',
            label: 'Remover bytes nulos',
            fn: (text) => {
                const next = text.replace(NULL_REGEX, '');
                return { text: next, count: text.length - next.length, example: '\\x00' };
            },
        },
        {
            key: 'zeroWidth',
            label: 'Remover caracteres Unicode de ancho cero',
            fn: (text) => {
                const next = text.replace(ZERO_WIDTH_REGEX, '');
                const match = text.match(ZERO_WIDTH_REGEX);
                const example = match ? `\\u${match[0].codePointAt(0)?.toString(16).toUpperCase().padStart(4, '0')}` : '';
                return { text: next, count: text.length - next.length, example };
            },
        },
        {
            key: 'normalizeLines',
            label: 'Normalizar saltos de línea a LF',
            fn: (text) => {
                const next = text.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
                return { text: next, count: text.length - next.length, example: '\\r\\n' };
            },
        },
        {
            key: 'trim',
            label: 'Recortar espacios al inicio y al final',
            fn: (text) => {
                const next = text.trim();
                const count = text.length - next.length;
                const example = count > 0 ? 'espacio inicial/final' : '';
                return { text: next, count, example };
            },
        },
        {
            key: 'collapseWhitespace',
            label: 'Colapsar espacios consecutivos',
            fn: (text) => {
                const next = text.replace(/\s+/g, ' ');
                return { text: next, count: text.length - next.length, example: 'varios espacios' };
            },
        },
    ];

    const escapeModes: Record<EscapeMode, (text: string) => StepResult> = {
        none: (text) => ({ text, count: 0, example: '' }),
        quotes: (text) => {
            const next = text.replace(/[\\"']/g, '\\$&');
            return { text: next, count: next.length - text.length, example: '"' };
        },
        json: (text) => {
            const next = JSON.stringify(text).slice(1, -1);
            return { text: next, count: next.length - text.length, example: '"' };
        },
        html: (text) => {
            const next = text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
            return { text: next, count: next.length - text.length, example: '<' };
        },
        url: (text) => {
            const next = encodeURIComponent(text);
            return { text: next, count: next.length - text.length, example: 'espacio' };
        },
    };

    const input = document.getElementById('sanitizer-input') as HTMLTextAreaElement;
    const output = document.getElementById('sanitizer-output') as HTMLTextAreaElement;
    const escapeSelect = document.getElementById('sanitizer-escape') as HTMLSelectElement;
    const cleanersContainer = document.getElementById('sanitizer-cleaners') as HTMLDivElement;
    const copyBtn = document.getElementById('sanitizer-copy-btn') as HTMLButtonElement;
    const clearBtn = document.getElementById('sanitizer-clear-btn') as HTMLButtonElement;
    const logPanel = document.getElementById('sanitizer-log-panel') as HTMLDivElement;
    const logList = document.getElementById('sanitizer-log') as HTMLUListElement;
    const feedback = document.getElementById('sanitizer-feedback') as HTMLDivElement;

    function renderCleanerCheckboxes() {
        cleanersContainer.innerHTML = cleaners.map((c) => `
            <label class="flex items-center gap-3 cursor-pointer group">
                <input
                    type="checkbox"
                    class="sanitizer-cleaner-checkbox w-4 h-4 rounded border-white/10 bg-white/5 text-blue-500 focus:ring-blue-500/40"
                    data-key="${c.key}"
                />
                <span class="text-sm text-gray-400 group-hover:text-gray-300 transition-colors select-none">${c.label}</span>
            </label>
        `).join('');
    }

    function readStateFromDOM(): State {
        const cleanerState = {} as Record<CleanerKey, boolean>;
        cleanersContainer.querySelectorAll<HTMLInputElement>('.sanitizer-cleaner-checkbox').forEach((cb) => {
            const key = cb.dataset.key as CleanerKey;
            cleanerState[key] = cb.checked;
        });
        return {
            input: input.value,
            cleaners: cleanerState,
            escape: escapeSelect.value as EscapeMode,
        };
    }

    function sanitize(state: State): Result {
        let text = state.input;
        const log: LogEntry[] = [];

        for (const cleaner of cleaners) {
            if (!state.cleaners[cleaner.key]) continue;
            const before = text;
            const result = cleaner.fn(before);
            text = result.text;
            if (result.count > 0) {
                log.push({
                    key: cleaner.key,
                    label: cleaner.label,
                    count: result.count,
                    example: result.example,
                    type: 'removed',
                });
            }
        }

        const escapeResult = escapeModes[state.escape](text);
        if (state.escape !== 'none' && escapeResult.count > 0) {
            log.push({
                key: state.escape,
                label: escapeLabel(state.escape),
                count: escapeResult.count,
                example: escapeResult.example,
                type: 'escaped',
            });
        }
        text = escapeResult.text;

        return { output: text, log };
    }

    function escapeLabel(mode: EscapeMode): string {
        switch (mode) {
            case 'quotes': return 'Escape de comillas y barras';
            case 'json': return 'Escape para JSON';
            case 'html': return 'Escape para HTML';
            case 'url': return 'Codificación URL';
            default: return 'Escape';
        }
    }

    function renderLog(log: LogEntry[]) {
        if (log.length === 0) {
            logPanel.classList.add('hidden');
            logList.innerHTML = '';
            return;
        }

        logPanel.classList.remove('hidden');
        logList.innerHTML = log.map((entry) => `
            <li class="flex items-center justify-between gap-4 text-sm">
                <span class="text-gray-300">${entry.label}</span>
                <div class="flex items-center gap-4">
                    <span class="text-xs text-gray-500">${entry.type === 'removed' ? 'removido' : 'escapado'}: <strong class="text-white">${entry.count}</strong></span>
                    ${entry.example ? `<code class="text-xs font-mono text-emerald-400 bg-white/5 px-2 py-0.5 rounded">${escapeHtml(entry.example)}</code>` : ''}
                </div>
            </li>
        `).join('');
    }

    function escapeHtml(value: string): string {
        return value
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function showFeedback(message: string, isError = false) {
        feedback.textContent = message;
        feedback.className = isError
            ? 'text-sm min-h-[1.25rem] text-red-400'
            : 'text-sm min-h-[1.25rem] text-emerald-400';
        if (!message) {
            feedback.className = 'text-sm min-h-[1.25rem]';
            return;
        }
        setTimeout(() => {
            feedback.textContent = '';
            feedback.className = 'text-sm min-h-[1.25rem]';
        }, 2500);
    }

    function updateAll() {
        const state = readStateFromDOM();
        const result = sanitize(state);
        output.value = result.output;
        renderLog(result.log);
    }

    async function copyOutput() {
        const value = output.value;
        if (!value) return;
        try {
            await navigator.clipboard.writeText(value);
            const original = copyBtn.innerHTML;
            copyBtn.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                ¡Copiado!
            `;
            copyBtn.classList.add('tool-btn-success');
            copyBtn.classList.remove('tool-btn-primary');
            showFeedback('Resultado copiado al portapapeles.');
            setTimeout(() => {
                copyBtn.innerHTML = original;
                copyBtn.classList.add('tool-btn-primary');
                copyBtn.classList.remove('tool-btn-success');
            }, 2000);
        } catch {
            showFeedback('No se pudo copiar al portapapeles. Verificá los permisos.', true);
        }
    }

    function clearAll() {
        input.value = '';
        output.value = '';
        logPanel.classList.add('hidden');
        logList.innerHTML = '';
        cleanersContainer.querySelectorAll<HTMLInputElement>('.sanitizer-cleaner-checkbox').forEach((cb) => {
            cb.checked = false;
        });
        escapeSelect.value = 'none';
        feedback.textContent = '';
        feedback.className = 'text-sm min-h-[1.25rem]';
        input.focus();
    }

    renderCleanerCheckboxes();

    input.addEventListener('input', updateAll);
    escapeSelect.addEventListener('change', updateAll);
    cleanersContainer.addEventListener('change', updateAll);
    copyBtn.addEventListener('click', copyOutput);
    clearBtn.addEventListener('click', clearAll);

    updateAll();
</script>
