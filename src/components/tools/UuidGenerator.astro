---
// UUID / GUID Generator
---

<div class="max-w-5xl mx-auto space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Configuration Panel -->
        <div class="tool-panel lg:col-span-1 space-y-6">
            <div class="flex items-center gap-3">
                <span class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-600 text-[10px] font-bold text-white">⚙</span>
                <h2 class="text-sm font-bold text-white uppercase tracking-wider">Configuración</h2>
            </div>

            <div class="space-y-3">
                <label for="uuid-version" class="tool-label !mb-0">Versión</label>
                <select id="uuid-version" class="tool-select">
                    <option value="v4">v4 — Aleatorio</option>
                    <option value="v7">v7 — Sortable (timestamp)</option>
                    <option value="v1">v1 — Timestamp + node</option>
                    <option value="nil">Nil — Todo ceros</option>
                    <option value="max">Max — Todo Fs</option>
                </select>
                <p id="version-hint" class="text-xs text-gray-500">UUID completamente aleatorio. El más usado.</p>
            </div>

            <div class="space-y-3">
                <label for="uuid-format" class="tool-label !mb-0">Formato</label>
                <select id="uuid-format" class="tool-select">
                    <option value="standard">Estándar (con guiones)</option>
                    <option value="noHyphens">Sin guiones</option>
                    <option value="uppercase">MAYÚSCULAS</option>
                    <option value="braces">{'{'} entre llaves {'}'}</option>
                    <option value="parentheses">( entre paréntesis )</option>
                    <option value="urn">URN urn:uuid:</option>
                    <option value="c#">C# Guid</option>
                    <option value="base64">Base64</option>
                    <option value="base62">Base62 (URL-safe)</option>
                </select>
            </div>

            <div class="space-y-3">
                <label for="uuid-count" class="tool-label !mb-0">Cantidad</label>
                <input id="uuid-count" type="number" min="1" max="1000" value="5" class="tool-input" />
            </div>

            <button id="generate-btn" class="tool-btn tool-btn-primary w-full">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                Generar
            </button>
        </div>

        <!-- Output Panel -->
        <div class="tool-panel lg:col-span-2 space-y-4">
            <div class="flex items-center justify-between">
                <label class="tool-label !mb-0">Resultados</label>
                <div class="flex gap-2">
                    <button id="copy-all-btn" class="tool-btn tool-btn-ghost !py-1.5 !px-3 !text-[11px]">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                        Copiar todo
                    </button>
                    <button id="clear-btn" class="tool-btn tool-btn-ghost !py-1.5 !px-3 !text-[11px]">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                        Limpiar
                    </button>
                </div>
            </div>
            <div id="uuid-list" class="space-y-2 max-h-[28rem] overflow-y-auto pr-1">
                <!-- UUIDs will appear here -->
            </div>
            <p id="empty-state" class="text-sm text-gray-500 text-center py-8">Presioná "Generar" para crear UUIDs.</p>
        </div>
    </div>

    <!-- Validator Panel -->
    <div class="tool-panel space-y-4">
        <div class="flex items-center gap-3">
            <span class="flex items-center justify-center w-6 h-6 rounded-full bg-emerald-600 text-[10px] font-bold text-white">✓</span>
            <h2 class="text-sm font-bold text-white uppercase tracking-wider">Validador de UUID</h2>
        </div>
        <div class="flex flex-col sm:flex-row gap-4">
            <input id="validate-input" type="text" placeholder="Pega un UUID para validar..." class="tool-input flex-1" />
            <button id="validate-btn" class="tool-btn tool-btn-success whitespace-nowrap">Validar</button>
        </div>
        <p id="validate-result" class="hidden text-sm font-medium"></p>
    </div>
</div>

<script>
    type UuidVersion = 'v1' | 'v4' | 'v7' | 'nil' | 'max';
    type UuidFormat = 'standard' | 'noHyphens' | 'uppercase' | 'braces' | 'parentheses' | 'urn' | 'c#' | 'base64' | 'base62';

    // ─── Core UUID bytes ─────────────────────────────────────────────────────────
    function bytesToHex(bytes: Uint8Array): string {
        return Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
    }

    function hexToBytes(hex: string): Uint8Array {
        const bytes = new Uint8Array(hex.length / 2);
        for (let i = 0; i < bytes.length; i++) {
            bytes[i] = parseInt(hex.substr(i * 2, 2), 16);
        }
        return bytes;
    }

    function bytesToUuid(bytes: Uint8Array): string {
        const hex = bytesToHex(bytes);
        return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
    }

    function getRandomBytes(length: number): Uint8Array {
        if (typeof crypto !== 'undefined' && crypto.getRandomValues) {
            return crypto.getRandomValues(new Uint8Array(length));
        }
        const arr = new Uint8Array(length);
        for (let i = 0; i < length; i++) arr[i] = Math.floor(Math.random() * 256);
        return arr;
    }

    // ─── UUID versions ───────────────────────────────────────────────────────────
    function uuidv4(): string {
        if (typeof crypto !== 'undefined' && (crypto as any).randomUUID) {
            return (crypto as any).randomUUID();
        }
        const bytes = getRandomBytes(16);
        bytes[6] = (bytes[6] & 0x0f) | 0x40;
        bytes[8] = (bytes[8] & 0x3f) | 0x80;
        return bytesToUuid(bytes);
    }

    function uuidv7(): string {
        const now = Date.now();
        const bytes = new Uint8Array(16);
        bytes[0] = (now >> 40) & 0xff;
        bytes[1] = (now >> 32) & 0xff;
        bytes[2] = (now >> 24) & 0xff;
        bytes[3] = (now >> 16) & 0xff;
        bytes[4] = (now >> 8) & 0xff;
        bytes[5] = now & 0xff;
        const rand = getRandomBytes(10);
        bytes.set(rand, 6);
        bytes[6] = (bytes[6] & 0x0f) | 0x70;
        bytes[8] = (bytes[8] & 0x3f) | 0x80;
        return bytesToUuid(bytes);
    }

    let lastV1Time = 0;
    let clockSeq = 0;
    function uuidv1(): string {
        let now = Date.now();
        if (now <= lastV1Time) {
            clockSeq = (clockSeq + 1) & 0x3fff;
        } else {
            clockSeq = Math.floor(Math.random() * 0x4000);
        }
        lastV1Time = now;
        const uuidEpoch = 122192928000000000n;
        const ts100ns = BigInt(now) * 10000n + uuidEpoch;
        const timeLow = Number(ts100ns & 0xffffffffn);
        const timeMid = Number((ts100ns >> 32n) & 0xffffn);
        const timeHi = Number((ts100ns >> 48n) & 0x0fffn) | 0x1000;
        const bytes = new Uint8Array(16);
        bytes[0] = (timeLow >> 24) & 0xff; bytes[1] = (timeLow >> 16) & 0xff;
        bytes[2] = (timeLow >> 8) & 0xff; bytes[3] = timeLow & 0xff;
        bytes[4] = (timeMid >> 8) & 0xff; bytes[5] = timeMid & 0xff;
        bytes[6] = (timeHi >> 8) & 0xff; bytes[7] = timeHi & 0xff;
        bytes[8] = 0x80 | ((clockSeq >> 8) & 0x3f);
        bytes[9] = clockSeq & 0xff;
        const node = getRandomBytes(6);
        node[0] |= 0x01;
        bytes.set(node, 10);
        return bytesToUuid(bytes);
    }

    function uuidNil(): string { return '00000000-0000-0000-0000-000000000000'; }
    function uuidMax(): string { return 'ffffffff-ffff-ffff-ffff-ffffffffffff'; }

    function generateRaw(version: UuidVersion): string {
        switch (version) {
            case 'v4': return uuidv4();
            case 'v7': return uuidv7();
            case 'v1': return uuidv1();
            case 'nil': return uuidNil();
            case 'max': return uuidMax();
        }
    }

    // ─── Formatters ──────────────────────────────────────────────────────────────
    const BASE62 = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
    function toBase62(hex: string): string {
        let n = BigInt('0x' + hex);
        if (n === 0n) return '0';
        let result = '';
        while (n > 0n) {
            result = BASE62[Number(n % 62n)] + result;
            n = n / 62n;
        }
        return result;
    }

    function formatUuid(raw: string, format: UuidFormat): string {
        switch (format) {
            case 'standard': return raw;
            case 'noHyphens': return raw.replace(/-/g, '');
            case 'uppercase': return raw.toUpperCase();
            case 'braces': return `{${raw}}`;
            case 'parentheses': return `(${raw})`;
            case 'urn': return `urn:uuid:${raw}`;
            case 'c#': return `{${raw.toUpperCase()}}`;
            case 'base64': {
                const bytes = hexToBytes(raw.replace(/-/g, ''));
                let binary = '';
                bytes.forEach(b => binary += String.fromCharCode(b));
                return btoa(binary);
            }
            case 'base62': return toBase62(raw.replace(/-/g, ''));
        }
    }

    // ─── Validation ──────────────────────────────────────────────────────────────
    function detectVersion(raw: string): string {
        const v = parseInt(raw[14], 16);
        if (raw === uuidNil()) return 'nil';
        if (raw === uuidMax()) return 'max';
        return `v${v}`;
    }

    function validateUuid(input: string): { valid: boolean; version?: string; raw?: string } {
        const cleaned = input.trim().toLowerCase();
        let raw = cleaned;
        if (raw.startsWith('urn:uuid:')) raw = raw.slice(9);
        if ((raw.startsWith('{') && raw.endsWith('}')) || (raw.startsWith('(') && raw.endsWith(')'))) {
            raw = raw.slice(1, -1);
        }
        raw = raw.replace(/-/g, '');
        if (!/^[0-9a-f]{32}$/i.test(raw)) return { valid: false };
        raw = `${raw.slice(0, 8)}-${raw.slice(8, 12)}-${raw.slice(12, 16)}-${raw.slice(16, 20)}-${raw.slice(20)}`;
        return { valid: true, version: detectVersion(raw), raw };
    }

    // ─── DOM wiring ──────────────────────────────────────────────────────────────
    const versionSelect = document.getElementById('uuid-version') as HTMLSelectElement;
    const formatSelect = document.getElementById('uuid-format') as HTMLSelectElement;
    const countInput = document.getElementById('uuid-count') as HTMLInputElement;
    const generateBtn = document.getElementById('generate-btn') as HTMLButtonElement;
    const uuidList = document.getElementById('uuid-list') as HTMLDivElement;
    const emptyState = document.getElementById('empty-state') as HTMLParagraphElement;
    const copyAllBtn = document.getElementById('copy-all-btn') as HTMLButtonElement;
    const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
    const versionHint = document.getElementById('version-hint') as HTMLParagraphElement;
    const validateInput = document.getElementById('validate-input') as HTMLInputElement;
    const validateBtn = document.getElementById('validate-btn') as HTMLButtonElement;
    const validateResult = document.getElementById('validate-result') as HTMLParagraphElement;

    const hints: Record<UuidVersion, string> = {
        v4: 'UUID completamente aleatorio. El más usado.',
        v7: 'UUID basado en timestamp. Son sortables por fecha de creación.',
        v1: 'UUID basado en timestamp y node ID. Menos usado hoy por privacidad.',
        nil: 'UUID nulo: 00000000-0000-0000-0000-000000000000.',
        max: 'UUID máximo: todo Fs. Útil para rangos de búsqueda.',
    };

    versionSelect.addEventListener('change', () => {
        versionHint.textContent = hints[versionSelect.value as UuidVersion];
    });

    function createUuidRow(value: string): HTMLDivElement {
        const row = document.createElement('div');
        row.className = 'flex items-center gap-3 bg-white/5 border border-white/10 rounded-xl p-3 group hover:border-blue-500/30 transition-colors';
        row.innerHTML = `
            <code class="flex-1 font-mono text-sm text-emerald-300 break-all">${value.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</code>
            <button class="copy-one tool-btn tool-btn-ghost !py-1.5 !px-2 !text-[11px] opacity-60 group-hover:opacity-100" data-value="${value.replace(/"/g, '&quot;')}">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            </button>
        `;
        row.querySelector('.copy-one')?.addEventListener('click', (e) => {
            const btn = e.currentTarget as HTMLButtonElement;
            const val = btn.dataset.value!;
            navigator.clipboard.writeText(val).then(() => {
                const original = btn.innerHTML;
                btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>`;
                setTimeout(() => btn.innerHTML = original, 1500);
            });
        });
        return row;
    }

    function generate() {
        const version = versionSelect.value as UuidVersion;
        const format = formatSelect.value as UuidFormat;
        let count = parseInt(countInput.value) || 1;
        if (count < 1) count = 1;
        if (count > 1000) count = 1000;

        uuidList.innerHTML = '';
        emptyState.classList.add('hidden');
        const seen = new Set<string>();
        for (let i = 0; i < count; i++) {
            let raw = generateRaw(version);
            // Avoid duplicates for non-random versions
            if (version === 'nil' || version === 'max') {
                if (seen.has(raw)) break;
                seen.add(raw);
            }
            const formatted = formatUuid(raw, format);
            uuidList.appendChild(createUuidRow(formatted));
        }
    }

    generateBtn.addEventListener('click', generate);

    copyAllBtn.addEventListener('click', () => {
        const codes = Array.from(uuidList.querySelectorAll('code')).map(c => c.textContent).join('\n');
        if (!codes) return;
        navigator.clipboard.writeText(codes).then(() => {
            const original = copyAllBtn.innerHTML;
            copyAllBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> ¡Copiados!`;
            copyAllBtn.classList.add('!text-emerald-400');
            setTimeout(() => { copyAllBtn.innerHTML = original; copyAllBtn.classList.remove('!text-emerald-400'); }, 2000);
        });
    });

    clearBtn.addEventListener('click', () => {
        uuidList.innerHTML = '';
        emptyState.classList.remove('hidden');
    });

    validateBtn.addEventListener('click', () => {
        const result = validateUuid(validateInput.value);
        validateResult.classList.remove('hidden');
        if (result.valid) {
            validateResult.className = 'text-sm font-medium text-emerald-400';
            validateResult.textContent = `✓ UUID válido · versión ${result.version} · estándar: ${result.raw}`;
        } else {
            validateResult.className = 'text-sm font-medium text-red-400';
            validateResult.textContent = '✗ No es un UUID válido.';
        }
    });

    validateInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') validateBtn.click(); });

    // Initial generation
    generate();
</script>
