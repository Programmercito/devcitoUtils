---
import Layout from "../layouts/Layout.astro";
import ToolCard from "../components/ToolCard.astro";

const base64Icon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4-4 4 4m0 6l-4 4-4-4" /></svg>`;
const jsonIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`;
const jwtIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H5v-2H3v-2H1v-4a6 6 0 017.743-5.743z" /></svg>`;
const shieldIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 20.944a11.955 11.955 0 0118 0z" /></svg>`;
const clockIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`;
const binaryIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20v-6m0 0V4m0 6h4m-4 0H6m4 0v6m0-6V4m0 6h4m-4 0H6" /></svg>`;
const fingerprintIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0012 11c1.23 0 2.418.07 3.566.203m-11.82 4.242A21.88 21.88 0 0012 11c-1.23 0-2.418-.07-3.566-.203M12 11c0-3.517 1.009-6.799 2.753-9.571m3.44 2.04l-.054.09A13.916 13.916 0 0016 11a4 4 0 11-8 0c0-1.017.07-2.019.203-3m2.118-6.844A21.88 21.88 0 0012 11c-1.23 0-2.418-.07-3.566-.203" /></svg>`;
const markdownIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>`;
const textIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" /></svg>`;
const urlIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 00(5.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>`;
const aiIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>`;
const sshIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H5v-2H3v-2H1v-4a6 6 0 017.743-5.743z" /></svg>`;
const convertIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>`;
const qrIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m-8 7H3m9 9v-1m9-8h-1M5 5h4v4H5V5zm10 0h4v4h-4V5zm0 10h4v4h-4v-4zm-10 0h4v4H5v-4z" /></svg>`;
const diffIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 4H5a2 2 0 00-2 2v12a2 2 0 002 2h4M15 4h4a2 2 0 012 2v12a2 2 0 01-2 2h-4M9 12h6M12 9l3 3-3 3" /></svg>`;
const colorIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" /></svg>`;
const textTransformIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`;
const tsIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /><path stroke-linecap="round" stroke-linejoin="round" d="M14 12h5m-2.5-2.5v5" /></svg>`;
const uuidIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m-4-4h8" /></svg>`;
const gitignoreIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`;
const sanitizerIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>`;
const sqlIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7c0-2.21-3.582-4-8-4s-8 1.79-8 4z" /><path stroke-linecap="round" stroke-linejoin="round" d="M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4" /><path stroke-linecap="round" stroke-linejoin="round" d="M4 12c0 2.21 3.582 4 8 4s8-1.79 8-4" /></svg>`;

const tools = [
    {
        title: "Codificador / Decodificador Base64",
        description: "Codifica y decodifica texto fácilmente al formato Base64.",
        href: "/tools/base64",
    },
    {
        title: "Codificador / Decodificador URL",
        description: "Codifica y decodifica texto para que sea seguro en URLs.",
        href: "/tools/url-encoder",
        icon: urlIcon,
    },
    {
        title: "Conversor a Array de Bytes",
        description: "Convierte una cadena de texto a su array de bytes (Hex, Dec, Bin).",
        href: "/tools/bytes-converter",
        icon: binaryIcon,
    },
    {
        title: "Conversor de Archivos",
        description: "Convierte entre diferentes formatos de archivos de forma rápida y segura.",
        href: "https://converter.devcito.org",
        icon: convertIcon,
    },
    {
        title: "Conversor de Colores",
        description: "Convierte entre HEX, RGB, HSL, HSV, CMYK y sus variantes con alpha.",
        href: "/tools/color-converter",
        icon: colorIcon,
    },
    {
        title: "Conversor de Timestamp",
        description: "Convierte entre fechas legibles y timestamps de Unix.",
        href: "/tools/timestamp-converter",
        icon: clockIcon,
    },
    {
        title: "Decodificador de JWT",
        description: "Inspecciona el contenido de tokens de autenticación (JWT).",
        href: "/tools/jwt-decoder",
        icon: jwtIcon,
    },
    {
        title: "Diferenciador de Archivos",
        description: "Compara archivos y textos en paralelo de manera 100% serverless y privada.",
        href: "https://diff.devcito.org",
        icon: diffIcon,
    },
    {
        title: "Formateador, Stringificador y Desstringificador JSON",
        description: "Formateá, minificá, stringificá, desstringificá, validá, copiá y cargá ejemplos de JSON.",
        href: "/tools/json-formatter",
    },
    {
        title: "Formateador y Minificador de SQL",
        description: "Formateá y minificá consultas SQL con soporte para múltiples dialectos y opciones de estilo.",
        href: "/tools/sql-formatter",
        icon: sqlIcon,
        isNew: true,
    },
    {
        title: "Generador de Códigos QR",
        description: "Crea códigos QR personalizados para enlaces, textos y Wi-Fi al instante.",
        href: "https://qr.devcito.org",
        icon: qrIcon,
    },
    {
        title: "Generador de Hashes (SHA)",
        description: "Calcula la huella digital de un texto con algoritmos seguros.",
        href: "/tools/hash-generator",
        icon: fingerprintIcon,
    },
    {
        title: "Generador de Llaves SSH",
        description: "Genera pares de llaves RSA para SSH usando entropía real del movimiento de tu mouse.",
        href: "/tools/ssh-keygen",
        icon: sshIcon,
    },
    {
        title: "Generador de TypeScript desde JSON",
        description: "Convertí JSON en interfaces o types de TypeScript con detección de fechas, opcionales y resaltado de sintaxis.",
        href: "/tools/json-to-typescript",
        icon: tsIcon,
        isNew: true,
    },
    {
        title: "Generador de UUID / GUID",
        description: "Generá UUIDs v4, v7, v1, nil y max en todos los formatos: estándar, Base64, Base62, URN, C# Guid y más.",
        href: "/tools/uuid-generator",
        icon: uuidIcon,
        isNew: true,
    },
    {
        title: "Generador de .gitignore",
        description: "Armá archivos .gitignore completos para cualquier stack: lenguajes, frameworks, editores y herramientas cloud.",
        href: "/tools/gitignore-generator",
        icon: gitignoreIcon,
        isNew: true,
    },
    {
        title: "Previsualizador de Markdown",
        description: "Escribe Markdown y ve el resultado en HTML en tiempo real.",
        href: "/tools/markdown-previewer",
        icon: markdownIcon,
    },
    {
        title: "Reescritor de Texto con IA",
        description: "Mejora o reformula textos utilizando un prompt personalizado.",
        href: "/tools/ai-rewriter",
        icon: aiIcon,
    },
    {
        title: "Transformador de Texto",
        description: "Transforma texto entre camelCase, snake_case, kebab-case, CONSTANT_CASE y más.",
        href: "/tools/text-transformer",
        icon: textTransformIcon,
    },
    {
        title: "Verificador de Firma HMAC",
        description: "Valida una firma HMAC-SHA256 con una clave secreta.",
        href: "/tools/hmac-verifier",
        icon: shieldIcon,
    },
    {
        title: "Contador de Texto",
        description: "Cuenta caracteres, palabras, líneas y tamaño en bytes.",
        href: "/tools/text-counter",
        icon: textIcon,
    },
    {
        title: "Sanitizador de Texto",
        description: "Eliminá caracteres de control, bytes nulos, espacios de ancho cero y escapá para JSON, HTML o URL.",
        href: "/tools/text-sanitizer",
        icon: sanitizerIcon,
        isNew: true,
    },
];
---

<Layout
    title="Herramientas para Desarrolladores Online | Devcito Utils"
    description="Herramientas gratuitas para desarrolladores: formatea JSON y SQL, genera UUID y hashes, convierte Base64 y más. Rápidas y privadas, en tu navegador."
    keywords="herramientas desarrolladores, utilidades online, base64, json formatter, jwt decoder, uuid generator, gitignore generator, typescript json, hash sha, hmac, markdown preview, url encoder"
>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-30px) scale(1.05); }
  }
  .animate-float { animation: float 10s ease-in-out infinite; }
  
  .grain {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3 Jacques 3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    opacity: 0.03;
  }

  .shimmer-text {
    background: linear-gradient(
      to right,
      #3b82f6 20%,
      #06b6d4 30%,
      #8b5cf6 70%,
      #3b82f6 80%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-fill-color: transparent;
    background-size: 200% auto;
    animation: textShimmer 4s linear infinite;
  }

  @keyframes textShimmer {
    to { background-position: 200% center; }
  }

  [hidden] { display: none !important; }

  .search-panel {
    background: radial-gradient(circle at 100% 0%, rgba(34, 211, 238, 0.1), transparent 42%),
      linear-gradient(135deg, rgba(20, 32, 54, 0.9), rgba(9, 15, 29, 0.95));
    border: 1px solid rgba(148, 180, 218, 0.16);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.2);
  }

  .search-field:focus-within {
    border-color: rgba(56, 189, 248, 0.8);
    box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.12);
  }

</style>

<main class="relative min-h-screen">
  <!-- Texture Overlay -->
  <div class="grain fixed inset-0 pointer-events-none z-50"></div>

  <!-- Hero Section -->
  <section class="relative min-h-[100svh] flex flex-col items-center justify-center overflow-hidden py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div class="text-center flex flex-col items-center justify-center">
        <h1 class="text-6xl sm:text-8xl md:text-9xl font-black mb-6 md:mb-10 tracking-tighter leading-none">
          <span class="shimmer-text">DevcitoUtils</span>
        </h1>
        
        <p class="max-w-2xl mx-auto text-base sm:text-xl md:text-2xl text-gray-400 leading-relaxed font-medium mb-10 md:mb-16">
          Herramientas gratuitas para desarrolladores: formateadores, conversores y generadores <span class="text-white">rápidos</span> y <span class="text-white">privados</span>.
        </p>

        <div class="flex justify-center w-full sm:w-auto px-4">
          <a href="#tools" class="group relative inline-flex items-center justify-center gap-4 px-12 py-6 bg-white text-black font-black rounded-2xl transition-all duration-300 hover:scale-105 active:scale-95 shadow-[0_0_50px_rgba(255,255,255,0.15)] w-full sm:w-auto text-lg">
            Ver Herramientas
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transition-transform group-hover:translate-y-1" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Floating Background Elements -->
    <div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-blue-600/10 rounded-full blur-[120px] animate-float opacity-30 -z-10"></div>
    <div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-cyan-600/10 rounded-full blur-[100px] animate-float opacity-30 -z-10" style="animation-delay: -5s"></div>
  </section>

  <!-- Tools Grid Section -->
  <section id="tools" class="py-24 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16">
        <div>
          <h2 class="text-4xl md:text-5xl font-black text-white tracking-tight mb-4">Catálogo de Herramientas</h2>
          <p class="text-gray-500 font-medium max-w-xl">
            Todo lo que necesitas en un solo lugar. Sin configuraciones, sin registros, solo utilidad pura.
          </p>
        </div>
        <div class="flex items-center gap-4 bg-white/5 border border-white/10 px-5 py-3 rounded-2xl backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
          <span class="text-sm font-bold text-gray-300">{tools.length} Herramientas Listas</span>
        </div>
      </div>

      <div class="search-panel rounded-3xl p-5 sm:p-8 mb-10">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-cyan-300 mb-2">Tu próxima herramienta</p>
            <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Encontrá lo que necesitás</h3>
            <p class="text-sm text-slate-400 mt-2">Buscá por nombre, función o tecnología.</p>
          </div>
          <p id="search-status" role="status" aria-live="polite" aria-atomic="true" class="text-sm font-medium text-slate-300">{tools.length} herramientas disponibles</p>
        </div>

        <div class="search-field mt-6 flex items-center gap-3 bg-gray-950/70 border border-white/15 rounded-2xl px-4 sm:px-5 py-2 transition-shadow">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <label for="tool-search" class="sr-only">Buscar herramientas</label>
          <input type="search" id="tool-search" placeholder="Probá con JSON, texto o códigos QR..." autocomplete="off" aria-controls="tools-grid" class="flex-1 bg-transparent text-white text-base placeholder:text-slate-500 outline-none min-w-0 py-4" />
          <button type="button" id="clear-search" hidden class="shrink-0 rounded-xl px-3 py-2 text-sm font-bold text-slate-300 hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">
            Limpiar <span class="sr-only">búsqueda</span>
          </button>
        </div>
        <div id="search-suggestions" hidden class="mt-5 flex flex-wrap items-center gap-2">
          <span class="text-xs font-medium text-slate-400 mr-1">Explorá:</span>
          {['JSON', 'Texto', 'Base64', 'QR'].map((term) => (
            <button type="button" data-search-term={term} class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-300 transition-colors hover:border-cyan-400/40 hover:bg-cyan-400/10 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">{term}</button>
          ))}
        </div>
      </div>

      <div id="no-results" hidden class="rounded-3xl border border-dashed border-slate-700 bg-slate-900/40 px-6 py-12 text-center mb-8">
        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-400/10 text-cyan-300">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-white">No encontramos herramientas</h3>
        <p class="mt-2 text-sm text-slate-400">Probá con otras palabras o limpiá la búsqueda para ver todo el catálogo.</p>
        <button type="button" id="reset-search" class="mt-5 rounded-xl border border-cyan-400/30 bg-cyan-400/10 px-4 py-2 text-sm font-bold text-cyan-200 hover:bg-cyan-400/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">
          Ver todas las herramientas
        </button>
      </div>

      <div id="tools-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {tools.map((tool) => (
          <div class="tool-card-wrapper h-full" data-title={tool.title} data-description={tool.description} data-href={tool.href}>
            <ToolCard {...tool} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-20 border-t border-white/5 relative overflow-hidden text-center">
    <div class="max-w-4xl mx-auto px-4 relative z-10">
      <p class="text-gray-400 leading-relaxed mb-10 max-w-lg mx-auto">
        Diseñado para la velocidad. Construido para la privacidad. <br/>
        Tus datos nunca salen de tu máquina.
      </p>
      <div class="flex items-center justify-center gap-8">
        <a href="https://devcito.org" target="_blank" class="text-sm font-bold text-gray-500 hover:text-white transition-colors uppercase tracking-widest">Website</a>
        <div class="w-1 h-1 rounded-full bg-gray-800"></div>
        <a href="https://github.com/devcito" target="_blank" class="text-sm font-bold text-gray-500 hover:text-white transition-colors uppercase tracking-widest">GitHub</a>
      </div>
      <p class="mt-8 text-sm text-gray-500 font-medium">
        Hecho con ❤️ por <a href="https://devcito.org" target="_blank" class="text-blue-400 hover:text-blue-300 transition-colors">Devcito</a>
      </p>
      <p class="mt-4 text-xs font-bold text-gray-700 uppercase tracking-widest">
        &copy; {new Date().getFullYear()} Devcito Utils. All rights reserved.
      </p>
    </div>
    
    <!-- Decorative -->
    <div class="absolute -bottom-20 -left-20 w-80 h-80 bg-blue-600/5 rounded-full blur-[100px]"></div>
    <div class="absolute -bottom-20 -right-20 w-80 h-80 bg-cyan-600/5 rounded-full blur-[100px]"></div>
  </footer>
</main>

<script>
  import { matchesSearch } from '../utils/tool-search.mjs';

  const searchInput = document.getElementById('tool-search') as HTMLInputElement;
  const wrappers = document.querySelectorAll<HTMLElement>('.tool-card-wrapper');
  const noResults = document.getElementById('no-results') as HTMLElement;
  const status = document.getElementById('search-status') as HTMLElement;
  const clearButton = document.getElementById('clear-search') as HTMLButtonElement;
  const resetButton = document.getElementById('reset-search') as HTMLButtonElement;
  const suggestions = document.getElementById('search-suggestions') as HTMLElement;

  function updateSearch() {
    const term = searchInput.value;
    let visible = 0;
    wrappers.forEach((wrapper) => {
      const match = matchesSearch(term, wrapper.dataset.title ?? '', wrapper.dataset.description ?? '', wrapper.dataset.href ?? '');
      wrapper.hidden = !match;
      if (match) visible++;
    });

    clearButton.hidden = !term;
    noResults.hidden = visible > 0;
    status.textContent = term.trim()
      ? `${visible} ${visible === 1 ? 'herramienta encontrada' : 'herramientas encontradas'}`
      : `${wrappers.length} herramientas disponibles`;
  }

  function clearSearch() {
    searchInput.value = '';
    updateSearch();
    searchInput.focus();
  }

  suggestions.hidden = false;
  searchInput.addEventListener('input', updateSearch);
  clearButton.addEventListener('click', clearSearch);
  resetButton.addEventListener('click', clearSearch);
  suggestions.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-search-term]');
    if (!button) return;
    searchInput.value = button.dataset.searchTerm ?? '';
    updateSearch();
    searchInput.focus();
  });
  updateSearch();
</script>
</Layout>
