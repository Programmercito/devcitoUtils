---
import Header from '../components/Header.astro';
import { canonicalUrl as getCanonicalUrl } from '../utils/seo.mjs';
import "../styles/global.css";

export interface Props {
	title: string;
    description: string;
    keywords?: string;
}

const { 
    title = 'Devcito Utils | Herramientas para Desarrolladores', 
    description = 'Una colección de herramientas online gratuitas para desarrolladores.',
    keywords = 'herramientas desarrolladores, utilidades online, base64, json, jwt, uuid, gitignore, desarrollo web'
} = Astro.props;

if (!Astro.site) throw new Error('Astro site is required for SEO metadata.');
const canonicalUrl = getCanonicalUrl(Astro.site, Astro.url.pathname);
const homeUrl = getCanonicalUrl(Astro.site, '/');
const image = new URL('/social-card.png', Astro.site).href;
const pageName = title.replace(/\s*\|\s*Devcito Utils$/, '');
const isToolPage = Astro.url.pathname.startsWith('/tools/');
const breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: "Inicio",
    item: homeUrl,
  },
];

if (isToolPage) {
  breadcrumbItems.push({
    "@type": "ListItem",
    position: 2,
    name: pageName,
    item: canonicalUrl,
  });
}

const graph = [
  {
    "@type": "WebSite",
    "@id": `${homeUrl}#website`,
    name: "Devcito Utils",
    url: homeUrl,
    inLanguage: "es",
  },
  {
    "@type": "WebPage",
    "@id": `${canonicalUrl}#webpage`,
    name: title,
    description,
    url: canonicalUrl,
    inLanguage: "es",
    isPartOf: { "@id": `${homeUrl}#website` },
    ...(isToolPage ? { breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` } } : {}),
  },
  ...(isToolPage ? [
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: breadcrumbItems,
    },
    {
      "@type": "WebApplication",
      name: pageName,
      description,
      url: canonicalUrl,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Web browser",
      offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
    },
  ] : []),
];

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph,
}).replace(/</g, '\\u003c');
---

<html lang="es">
	<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-WG7WJG9NE3"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-WG7WJG9NE3');
  </script>    
        <!-- SEO Meta Tags -->
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
        <meta name="robots" content="index, follow" />
		<title>{title}</title>
        <meta name="description" content={description} />
        <meta name="keywords" content={keywords} />
        <meta name="author" content="Devcito Utils" />
        <meta name="theme-color" content="#030712" />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" href={canonicalUrl} hrefLang="es" />
        <link rel="alternate" href={canonicalUrl} hrefLang="x-default" />

        <!-- Favicon -->
		<link rel="icon" href="/settings.ico" type="image/x-icon" />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Devcito Utils" />
        <meta property="og:locale" content="es_ES" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={image} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Devcito Utils - Herramientas online para desarrolladores" />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalUrl} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={image} />
        <meta property="twitter:image:alt" content="Devcito Utils - Herramientas online para desarrolladores" />

        <script type="application/ld+json" set:html={jsonLd} />

		<meta name="generator" content={Astro.generator} />
        <style>
            html {
                scroll-behavior: smooth;
            }
        </style>
	</head>
	<body class="bg-gray-950">
        <div class="bg-mesh" aria-hidden="true"></div>
        <Header currentPath={Astro.url.pathname} />
        <div class="h-20"></div>
        {isToolPage && (
          <nav aria-label="Ruta de navegación" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 text-sm text-gray-400">
            <ol class="flex flex-wrap items-center gap-2">
              <li><a href="/" class="hover:text-white focus-visible:outline-2 focus-visible:outline-blue-400">Inicio</a></li>
              <li aria-hidden="true">/</li>
              <li aria-current="page" class="text-gray-300">{pageName}</li>
            </ol>
          </nav>
        )}
		<slot />
	</body>
</html>
